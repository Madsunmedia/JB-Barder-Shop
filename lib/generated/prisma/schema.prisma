// prisma/schema.prisma
// JB Barbershop — Production-ready schema for Supabase + Vercel

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id               String   @id @default(cuid())
  customerName     String
  customerPhone    String
  customerEmail    String?
  serviceId        String
  serviceName      String
  servicePrice     Float
  appointmentDate  DateTime
  appointmentTime  String
  status           String   @default("confirmed") // confirmed, completed, cancelled, blocked
  whatsappNotified Boolean  @default(false)
  smsNotified      Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Client {
  id          String    @id @default(cuid())
  name        String
  phone       String    @unique
  email       String?
  notes       String?
  totalVisits Int       @default(0)
  totalSpent  Float     @default(0)
  lastVisit   DateTime?
  createdAt   DateTime  @default(now())
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  duration    Int
  price       Float
  category    String
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Campaign {
  id             String    @id @default(cuid())
  message        String
  audience       String
  recipientCount Int
  scheduledAt    DateTime?
  sentAt         DateTime?
  status         String    @default("draft")
  createdAt      DateTime  @default(now())
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  metaDesc    String
  content     String    @db.Text
  category    String
  coverImage  String?
  author      String    @default("JB Barbershop Team")
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Offer {
  id          String    @id @default(cuid())
  title       String
  description String
  ctaText     String
  isActive    Boolean   @default(false)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
